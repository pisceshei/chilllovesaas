<h1 id="sterms">{{ search.terms }}</h1><span id="sperf">{{ search.performed }}</span><span id="scount">{{ search.results_count }}</span><span id="ssort">{{ search.sort_by }}</span><span id="sdef">{{ search.default_sort_by }}</span><span id="stypes">{{ search.types | join: "," }}</span><span id="sopts">{% for o in search.sort_options %}{{ o.value }};{% endfor %}</span>
{% if search.performed %}{% paginate search.results by 2 %}<ul id="sgrid">{% for item in search.results %}<li data-ot="{{ item.object_type }}" data-h="{{ item.handle }}" data-u="{{ item.url }}">{{ item.title }}</li>{% endfor %}</ul><span id="spages">{{ paginate.pages }}</span>{% endpaginate %}{% endif %}
<ul id="sfacets">{% for filter in search.filters %}<li data-f="{{ filter.param_name }}">{% for value in filter.values %}<i data-v="{{ value.value }}" data-c="{{ value.count }}" data-add="{{ value.url_to_add }}"></i>{% endfor %}</li>{% endfor %}</ul>
{% schema %}{ "name": "Main search" }{% endschema %}
