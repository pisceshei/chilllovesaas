<h1 id="ctitle">{{ collection.title }}</h1><span id="ccount">{{ collection.products_count }}</span><span id="csort">{{ collection.sort_by }}</span><span id="cdefsort">{{ collection.default_sort_by }}</span>
{% paginate collection.products by 2 %}<ul id="cgrid">{% for product in collection.products %}<li data-h="{{ product.handle }}">{{ product.title }}|{{ product.price | money }}{% content_for "block", type: "_card", id: "card", closest.product: product, note: 'hot' %}</li>{% endfor %}</ul><span id="cpages">{{ paginate.pages }}</span><span id="cpage">{{ paginate.current_page }}</span><span id="citems">{{ paginate.items }}</span>{% if paginate.next %}<a id="cnext" href="{{ paginate.next.url }}">下一頁</a>{% endif %}{% for part in paginate.parts %}<i class="part">{{ part.title }}={{ part.url }}</i>{% endfor %}{% endpaginate %}
<span id="callcount">{{ collection.all_products_count }}</span>
<ul id="cfacets">{% for filter in collection.filters %}<li data-f="{{ filter.param_name }}" data-type="{{ filter.type }}" data-rmf="{{ filter.url_to_remove }}">{{ filter.label }}{% if filter.type == 'price_range' %}[{{ filter.min_value.value }}..{{ filter.max_value.value }}/{{ filter.range_max }}]{% endif %}{% for value in filter.values %}<i data-v="{{ value.value }}" data-c="{{ value.count }}" data-a="{{ value.active }}" data-add="{{ value.url_to_add }}" data-rm="{{ value.url_to_remove }}"></i>{% endfor %}</li>{% endfor %}</ul>
{% schema %}{ "name": "Main collection" }{% endschema %}
