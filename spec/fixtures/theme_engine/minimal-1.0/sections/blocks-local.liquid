<div id="bl">{% for block in section.blocks %}<em class="lb" data-type="{{ block.type }}" {{ block.shopify_attributes }}>{{ block.settings.body }}|{{ block.settings.size }}</em>{% endfor %}</div><span id="blc">{{ section.blocks.size }}</span>
{% schema %}{ "name": "Blocks local", "blocks": [ { "type": "text", "name": "Text", "settings": [ { "id": "body", "type": "text", "default": "dflt" }, { "id": "size", "type": "range", "min": 1, "max": 9, "step": 1, "default": 3 } ] }, { "type": "@theme" } ] }{% endschema %}
