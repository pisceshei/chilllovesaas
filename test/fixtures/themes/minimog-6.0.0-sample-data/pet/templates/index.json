    "166030916025f51775": {
      "type": "custom-code",
      "settings": {
        "custom_css": ":where(h1,h2,h3).m\\:text-black {\n  color: #0F4226;\n}\n\n.m-slider--home .m-slider-controls {\n  --swiper-controls-color: #0F4226 !important;\n}\n.m-slider--home .m-slide__title {\n  margin-bottom: 16px;\n}\n.m-slider--home .m-slide__description {\n  color: rgb(var(--color-button));\n  font-size: 20px;\n  margin-bottom: 38px;\n  font-weight: 600;\n  font-family: 'M-Body-Font';\n}\n\n.m-featured-collection--home .m-product-card.m-product-card--style-4 {\n  padding: 20px 20px 28px;\n  background-color: #fff;\n}\n.m-featured-collection--home .m-product-card.m-product-card--style-4:hover {\n  box-shadow: 0px 10px 30px 0px rgba(0,0,0,0.08);\n}\n\n.m-icon-box--home .m-icon-box__heading {\n  font-size: 20px;\n  line-height: 1.2;\n  color: rgb(var(--color-forceground));\n  margin-bottom: 15px;\n}\n\n.m-collection-card__title {\n  font-weight: var(--font-weight-header) !important;\n}\n.m-collection-list--home .m-collection-card__link {\n  color: #000;\n}\n.m-collection-list--home .m-collection-card__link:hover {\n  color: var(--color-primary);\n}\n\n.m-testimonial--home .m-section__heading {\n  font-size: 20px;\n  line-height: 1.2;\n}\n.m-testimonial--home .m-testimonial__description {\n  font-family: 'M-Heading-Font';\n  font-size: 34px;\n  margin-bottom: 34px;\n  line-height: 1.5;\n  color: #0F4226;\n}\n.m-testimonial--home .m-testimonial__name,\n.m-testimonial--home .m-testimonial__fraction {\n  font-weight: 700 !important;\n}\n.sf-instagram-description__button {\n  margin-top: 40px;\n}\n.sf-instagram-description__button a {\n  text-decoration: none;\n  font-weight: 700;\n  display: inline-flex;\n  align-items: center;\npadding: 10px 20px;\ncolor: rgb(var(--color-button-text));\n}\n.sf-instagram-description__button a img {\n  width: 16px;\n  height: 16px;\n  margin-right: 8px;\n}\n\n.sf-btn--follow {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  font-weight: 700;\n  text-decoration: none;\n}\n\n@media(max-width: 767px) {\n  .m-iwt--home .m-richtext {\n  \ttext-align: center;\n  } \n  .m-testimonial--home .sf-testimonials-description { \n    font-size: 24px;\n  }\n  .m-testimonial--home .section__header {\n    margin-bottom: 40px;\n  }\n  .sf-instagram-description__button {\n    margin-top: 30px;\n  }\n}"
      }
