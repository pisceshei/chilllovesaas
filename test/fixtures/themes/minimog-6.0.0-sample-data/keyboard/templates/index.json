      "settings": {
        "custom_css": ".m-richtext__subtitle {\n  letter-spacing: 1px;\n  font-weight: 600;\n}\n.m-icon-box--home .m-icon-box__heading {\n  font-size: 20px;\n  margin-bottom: 15px;\n}\n.m-video--home .m-video__inner {\n  border-radius: 10px;\n}\n\nbody .m-testimonial--home .m-testimonial__wrapper {\n  background-color: transparent;\n  font-size: 18px;\n  padding-top: 0;\n  padding-bottom: 0;\n}\nbody .m-testimonial--home .m-testimonial__description {\n  color: rgba(255,255,255, .8);\n}\n.m-testimonial--home .m-testimonial__name {\n  color: var(--color-primary);\n  font-weight: 600;\n}\n.sf-custom__product-form .main-product__block-vendor {\n  font-size: 15px;\n  letter-spacing: 1px;\n  text-transform: uppercase;\n}\n.sf-custom__product-form .m-product-title { \n  text-transform: uppercase; \n  font-weight: 600; \n}\n.sf-custom__product-form .m-custom-content__wrapper {\n  background-image: url('https:\/\/cdn.shopify.com\/s\/files\/1\/0147\/0962\/0800\/files\/kb_image_3.png?v=1660186193');\n  background-size: cover;\n  background-repeat: no-repeat;\n  background-position: center;\n  padding: 30px 15px;\n  border-radius: 10px;\n}\n\n.m-newsletter--home {\n  --color-border: #4B4B4B;\n}\n.m-newsletter--home .m-newsletter-section__description {\n  opacity: 1;\n}\n\n@media (min-width:1280px) {\n  .m-richtext__subtitle {\n    font-size: 18px;\n  }\n  .sf-custom__product-form .m-product-title {\n    font-size: 42px;\n  }\n  .sf-custom__product-form .m-custom-content__wrapper {\n    padding: 100px;\n    border-radius: 40px;\n  }\n  .m-video--home .m-video__inner {\n    border-radius: 40px;\n  }\n}\n\n@media (max-width: 767px) {\n  br {\n    display: none !important;\n  }\n}"
      }
