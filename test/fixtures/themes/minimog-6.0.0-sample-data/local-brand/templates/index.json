    "c72959ad-9620-4e94-ae33-1bde908e9701": {
      "type": "custom-code",
      "settings": {
        "custom_css": ".m-richtext__subtitle {\n  font-weight: 500;\n}\n.sf-home__collection-list .m-collection-card__link {\n  font-size: 18px;\n  font-weight: 500;\n}\n\n.sf-home__collection-list .m-collection-card__info sup {\n  font-weight: 500;\n}\n\n.sf-home__collection-list {\n  --mobile-column-width: 40vw;\n}\nbody .m-image-comparison__heading {\n  font-size: 16px;\n  text-transform: CAPITALIZE;\n  font-weight: 500;\n  border-radius: 5px;\n  letter-spacing: 0;\n}\n.sf-custom--image-comparision .m-richtext__title {\n  line-height: 1.33;\n}\n\n.sf-custom--promotion-banner .m-custom-content__wrapper {\n  background-repeat: no-repeat;\n  background-size: cover;\n  background-position: center center;\n  background-image: url(\"https:\/\/cdn.shopify.com\/s\/files\/1\/0595\/7291\/2305\/files\/banner-bg.jpg?v=1678680079\");\n  padding: 48px 15px;\n}\n.sf-promotion-banner--col-left {\n  margin-bottom: 24px;\n}\n\n.sf-promotion-banner--col-left .m-richtext__title  {\n  line-height: 1;\n  font-weight: 500;\n  font-size: 100px;\n  letter-spacing: 10px;\n}\n\n.sf-promotion-banner--col-right {\n  position: relative;\n}\n.sf-promotion-banner--col-right .content__heading {\n  font-size: 24px;\n  line-height: 1.4;\n}\n.sf-promotion-banner--col-right:before {\n  content: \"\";\n  left: 0;\n  top: 0;\n  background-color: #222;\n  width: 100%;\n  height: 1px;\n  position: absolute;\n}\n.sf-promotion-banner--col-right .m-custom-content__block-inner {\n  padding-top: 24px;\n}\n.sf-custom-text--large .prose {\n  color: var(--color-heading-text);\n}\n\n.sf-custom--image-comparision .m-richtext__title,\n.sf-favorite-product-slider__heading {\n  font-size: 36px;\n}\n\nbody .m-footer {\n  border-top-color: #fafafa !important;\n}\n\n@media (min-width: 768px) {\n  .sf-custom--promotion-banner .m-custom-content__wrapper {\n    padding: 60px 15px;\n  }\n  .sf-promotion-banner--col-left .m-richtext__subtitle {\n    font-size: 20px;\n  }\n  .sf-promotion-banner--col-right .m-richtext__title {\n    font-size: 36px;\n    line-height: 1.4;\n  }\n}\n@media (min-width: 1024px) {\n  .m-richtext__subtitle {\n    font-size: 20px;\n  }\n  .m-footer--block-newsletter .m-footer--block-title {\n    font-size: 28px;\n    font-weight: 400;\n  }\n  .sf-custom--promotion-banner .m-custom-content__wrapper {\n    padding: 70px 15px;\n  }\n  .sf-promotion-banner--col-left .m-richtext__title  {\n    font-size: 130px;\n  }\n  .sf-promotion-banner--col-left {\n    margin-bottom: 0;\n  }\n  .sf-promotion-banner--col-right:before {\n    width: 1px;\n    height: 100%;\n  }\n  .sf-promotion-banner--col-right .m-custom-content__block-inner {\n    padding-left: 60px;\n    padding-top: 0;\n  }\n}\n@media (min-width: 1280px) {\n  body .m-slide__subtitle {\n    margin-bottom: 24px;\n  }\n  \n  .sf-custom--image-comparision .m-richtext__title {\n    font-size: 60px;\n  }\n  .sf-promotion-banner--col-right .m-richtext__title {\n    font-size: 42px;\n    line-height: 1.4;\n  }\n}\n@media (min-width: 1536px) {\n  body .m-slide__title {\n    font-size: 70px;\n    line-height: 80px;\n    margin-bottom: 40px;\n  }\n  .sf-promotion-banner--col-right .m-custom-content__block-inner {\n    padding-left: 120px;\n  }\n}\n@media (max-width: 1023px) {\n  .sf-promotion-banner--col-right .m-custom-content__block-inner > div {\n    text-align: center;\n  }\n\n  .sf-custom--image-comparision .m-custom-content__block-text {\n    margin-bottom: 40px;\n  }\n}\n@media (max-width: 767px) {\n  .sf-icon-box--large .m-icon-box__heading {\n    font-size: 20px;\n  }\n  .m-collection-list .m-section__description {\n\t\tmargin-top: 0.3rem;\n\t}\n\n  .m-testimonials .m-section__header,\n  .m-collection-list .m-section__header {\n    text-align: center;\n  }\n  \n  .m-slider--content-stack .m-slide__wrapper {\n    padding-top: 32px;\n  }\n}"
      }
