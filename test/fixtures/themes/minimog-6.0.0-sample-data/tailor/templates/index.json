    "c72959ad-9620-4e94-ae33-1bde908e9701": {
      "type": "custom-code",
      "settings": {
        "custom_css": ".m-custom-lookbook .m-slider-controls--absolute .swiper-pagination {\nmargin-top: 0;\n}\n.m-custom-lookbook  .m-slider-controls--full .m-slider-controls__button-next {\nright: -80px;\n}\n.m-custom-lookbook  .m-slider-controls__button-prev {\nleft:-80px;\n}\n.m-custom-lookbook .m-slider-controls__button {\nbackground-color: rgb(var(--color-background-secondary));\ncolor: rgb(var(--color-foreground));\n}\n.m-custom-lookbook .m-slider-controls__button:hover{\nbackground-color: rgb(var(--color-button-hover));\ncolor: rgb(var(--color-button-text-hover));\nborder-color: rgb(var(--color-button-hover)); \n}\n\n@media(max-width: 1440px) {\n\n.m-custom-lookbook .m-lookbook__header {\nmargin-bottom: 24px;\n}\n.m-custom-lookbook .m-lookbook__heading {\nfont-size: 32px;\n}\n.m-custom-lookbook .m-lookbook__header {\nmargin-bottom: 12px;\n}\n}\n@media(max-width: 1280px) {\n.m-custom-lookbook .m-lookbook__heading {\nfont-size: 28px;\n}\n.m-lookbook-slider--image-right .m-lookbook-slider__wrapper--col-1 {\n  --offset-x: 15%;\n}\n}\n@media(max-width: 1023px) {\n .m-custom-lookbook .m-lookbook-card__image {\n    width: 100%;\nheight: 100%;\n  }\n.m-lookbook-slider--image-right .m-lookbook-slider__wrapper--col-1 {\npadding-bottom: 48px;\n}\n\n .m-custom-lookbook  .m-lookbook-slider>* {\nmax-width: 100% !important;\n}\n\n}\n@media (max-width: 1023px) and (min-width: 768px) {\n.m-custom-lookbook .m-lookbook__heading {\n  font-size: calc(((var(--font-h2-tablet)) \/(var(--font-base-size)))* 1rem);\n}\n.m-lookbook-slider--image-right .m-lookbook-slider__wrapper--col-1 {\n  --offset-x: 25%;\npadding-bottom: 48px;\n}\n}\n@media (max-width: 767px) {\n  .m-custom-lookbook .m-lookbook-slider__wrapper {\nmargin-top: 48px;\n}\n  .m-custom-lookbook .m-lookbook__heading {\n    font-size: calc(((var(--font-h2-mobile)) \/ (var(--font-base-size))) * 1rem);\n  }\n.m-lookbook-slider--image-right .m-lookbook-slider__wrapper--col-1 {\n  --offset-x: 23%;\n}\n    .m-custom-lookbook  .m-lookbook-slider__wrapper--col-1 .m-product-card {\n    display: block;\n  }\n  .m-custom-lookbook   .m-lookbook-slider__wrapper--col-1 .m-product-card__media {\n    width: 100%;\n  }\n\n.m-custom-lookbook  .m-slider-controls__button {\nposition:absolute;\n}\n.m-custom-lookbook  .m-lookbook__header {\ndisplay: none;\n\n}\n.m-custom-lookbook  .m-lookbook-slider .m-lookbook__header  {\ndisplay: block;\n}\n}\n@media(max-width: 280px) {\n.m-custom-lookbook  .m-slider-controls--full .m-slider-controls__button-next {\nright: -50px;\n\n}\n.m-custom-lookbook  .m-slider-controls__button-prev {\nleft:-50px;\n}\n\n}"
      }
    },
