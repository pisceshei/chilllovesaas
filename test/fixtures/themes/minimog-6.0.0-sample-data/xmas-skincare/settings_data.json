    "custom_css": ".m-topbar a[href*=\"pinterest\"],\n.m-topbar a[href*=\"twitter\"], \n.m-topbar a[href*=\"snapchat\"], \n.m-topbar a[href*=\"youtube\"],\n.m-topbar a[href*=\"tiktok\"]{\n\tdisplay: none;\n}\n.m-section__header {\n  --m-section-header-spacing-bottom: 40px;\n  --m-section-header-spacing-bottom-mobile: 32px;\n}\nbody .m-newsletter-section__description{\n   opacity: 1;\n}\nbody .m-product-card__tag-name {\n  font-size: 12px;\n  font-weight: 500;\n  text-transform: uppercase;\n  padding: 4px 8px;\n  border-radius: 0;\n}\n.m-icon-box--small {\n  border-top: 1px solid rgb(var(--color-border));\n}\n.m-icon-box--small .m-icon-box__heading {\n  line-height: 26px;\n  font-size: 18px;\n  margin-bottom: 6px;\n}\nbody .m-footer--block .social-media-links {\n    gap: 20px;  \n    padding: 5px 0;\n    margin: 0\n}\nbody .m-footer--middle .m-footer--block-content .block-text,\nbody .m-footer--block-content .block-text a{\n  margin-bottom: 12px;\n}\n/* Newsletter Mobile */\n.m-newsletter-section--vertical.input-vertical-mb .m-newsletter-section__form {\n  max-width: 530px;\n  width: 100%;\n}\n.m-newsletter-section--vertical.input-vertical-mb .m-newsletter-form__button-inline .m-newsletter-form__button--text {\n  position: relative;\n  margin-left: 8px;\n  padding: 12px 32px;\n}\n.m-newsletter-section--vertical.input-vertical-mb .form-field {\n  padding: 8px 12px;\n}\n@media (max-width: 767.9px) {\n  .m-newsletter-section--vertical.input-vertical-mb .m-newsletter-form__wrapper {\n    flex-direction: column;\n    align-items: center;\n  }\n  .m-newsletter-section--vertical.input-vertical-mb .m-newsletter-form__button-inline .m-newsletter-form__button--text {\n    margin-left: 0;\n    margin-top: 12px;\n  }\n}",
