        "custom_css": ".m-richtext__subtitle {\n  font-weight: 500;\n}\n.sf-home__iconbox {\n  border-top: 1px solid #eeeeee;\n}\n.sf-home__iconbox .m-icon-box__heading {\n  font-weight: 500;\n  font-size: 20px;\n}\n.sf-home__iconbox .m-icon-box__description {\n  color: #777777;\n}\n\n.sf-home__product-tabs .m-tab-header {\n  font-weight: 500;\n  line-height: 26px;\n}\n.sf-home__product-tabs .m-tab-header:after {\n  bottom: -4px;\n}\n\n.sf-home__custom-content .m-image-card__content-inner {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  height: 100%;\n  justify-content: space-between;\n}\n.sf-home__custom-content .m-image-card__content-inner .m-button--link::before {\n  background-color: rgba(0, 0, 0, 0.25);\n  height: 1px;\n}\n.sf-home__custom-content .m-image-card__content-inner .m-button--link::after {\n  height: 1px;\n}\n\n@media (min-width: 768px) {\n  .sf-home__image-with-slide .m-section-my {\n    margin-top: 0;\n  }\n}\n@media (min-width: 1280px) {\n  .sf-home__testimonial .m-testimonial__description {\n    font-size: 36px;\n    line-height: 52px;\n  }\n  .sf-home__image-with-slide .m-slide__description {\n    font-size: 20px;\n  }\n}\n@media (min-width: 1536px) {\n  .sf-home__image-with-slide .m-slide__title {\n    font-size: 70px;\n    line-height: 90px;\n  }\n}\n@media (max-width: 1920px) {\n  .sf-home__testimonial .m-testimonial__description br {\n    display: none;\n  }\n}\n@media (max-width: 767px) {\n  .sf-home__custom-content .m-image-card__content {\n    padding: 15px 20px;\n  }\n  .sf-home__custom-content .m-richtext__title {\n    font-size: 26px;\n  }\n  .sf-home__custom-content .m-richtext__button {\n    margin-top: 10px;\n  }\n}\n@media (max-width: 576px) {\n  .sf-home__iconbox .m-icon-box__heading {\n    font-size: 18px;\n  }\n}"
