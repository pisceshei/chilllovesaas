      "settings": {
        "custom_css": "body .m-richtext__description {\n  font-weight: var(--font-weight-body);\n}\n\n.m-collection-list--home .m-collection-card--inside .m-collection-card__info {\n  top: 0;\n}\n.m-collection-list--home .m-collection-card--inside .m-collection-card__title {\n  font-size: 22px;\n  font-weight: 700;\n  line-height: 1.14;\n  margin-bottom: 7px;\n}\n.m-collection-list--home .m-collection-card--inside .m-collection-card__info.m\\:text-left .m-collection-card__title {\n  align-self: end;\n}\n.m-collection-list--home .m-collection-card--inside .m-collection-card__inner {\n  border-radius: 5px;\n}\n.m-collection-list--home .m-collection-card--inside .m-button {\n  display: none;\n}\n\n.m-icon-box--home .m-icon-box__heading {\n  line-height: 1.14;\n  font-size: 22px;\n  margin-bottom: 16px;\n  font-weight: 700;\n} \n\n@media(min-width: 1280px) {\n  .m-section__header {\n    margin-bottom: 40px;\n  }\n  .m-collection-list--home .m-collection-list__content {\n    padding-right: calc((100vw - var(--m-scrollbar-width, 0px) - 1280px ) / 2) !important;\n    margin-right: 0 !important;\n  }\n}\n\n@media(max-width: 767px) {\n  .m-collection-list--home .m-collection-card--inside .m-collection-card__info {\n    padding: 12px;\n    position: absolute;\n  }\n  .m-collection-list--home .m-collection-card--inside .m-collection-card__title {\n    font-size: 16px !important;\n    margin-bottom: 0;\n  }\n}"
      }
