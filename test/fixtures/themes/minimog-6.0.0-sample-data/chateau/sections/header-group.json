  "sections": {
    "custom_code_jQAVr6": {
      "type": "custom-code",
      "settings": {
        "custom_css": ".m-custom-newsletter .m-newsletter-section__description {\n  opacity: 1;\n  margin-top: 16px;\n}\n.m-custom-newsletter .m-newsletter-form__button {\n  background-color: rgb(var(--color-button));\n  color: rgb(var(--color-button-text));\n  transition: all var(--m-duration-default, 0.25s);\n}\n.m-custom-newsletter .m-newsletter-form__button:hover,\n.m-newsletter-form__button:focus {\n  background-color: rgb(var(--color-button-hover));\n  color: rgb(var(--color-button-text-hover));\nborder-color: rgb(var(--color-button-hover));\n}\n\n  .m-custom-newsletter .m-newsletter-section__header {\n    margin-bottom: 32px;\n  }\n\n\n@media(min-width:1600px) {\n .m-first-section  .m-richtext__title {\n    font-size: 80px;\n  }\n .m-first-section  .m-richtext__subtitle {\nmargin-bottom: 24px;\n}\n}\n\n@media(max-width: 1360px) {\n.m-first-section .m-richtext__title {\nfont-size: 42px;\n}\n.m-image-custom__content .m-richtext__description  br{\ndisplay: none;\n}\n}\n\n@media(max-width: 1023px) {\n.m-first-section .m-section-py {\npadding-top: 0;\n}\n  .m-custom-newsletter  .m-newsletter-section__inner {\npadding: 0 20px;\n}\n.m-first-section .m-custom-content__wrapper   {\nflex-direction: column-reverse;\n}\n.m-first-section .m-custom-content__block-text {\npadding: 40px 16px ;\n}\n.m-first-section  .m-richtext {\ntext-align: center;\n}\n.m-first-section .m-richtext__title br {\ndisplay: none;\n}\n}\n@media(max-width: 767px) {\n.m-first-section .m-image {\n  --aspect-ratio: 0.86 !important;\n}\n.m-first-section br{\ndisplay: none;\n}\n\n.m-custom-compare .m-richtext__description  br{\ndisplay: none;\n}\n .m-first-section  .m-richtext__title {\nfont-size: 36px;\n}\n.m-custom-newsletter .m-newsletter-form__wrapper {\nflex-direction: column;\nrow-gap: 12px;\nalign-items: center;\n\n}\n.m-custom-newsletter .m-newsletter-form__button-inline .m-newsletter-form__button {\nposition: static;\nwidth: fit-content;\nborder-radius: 5px;\nborder-width-left: 1px;\n}\n.m-custom-newsletter .m-newsletter-section__header {\nmargin-bottom: 24px;\n}\n\n}"
      }
    },
