        "custom_css": ".sf__heading-color {\n  color: #322b81;\n}\n.sf__font-size-40 {\n  font-size: 40px;\n  line-height: 56px;\n}\n.sf__font-size-24 {\n    font-size: 24px;\n    line-height: 1.4;\n}\n.sf__text-style1 {\n  position: relative;\n  z-index: 1;\n}\n.sf__text-style1::after {\n  position: absolute;\n  content: \"\";\n  left: 50%;\n  bottom: 5px;\n  width: calc(100% + 4px);\n  height: 8px;\n  background: #fbf19b;\n  border-radius: 10px;\n  z-index: -1;\n  transform: translateX(-50%);\n}\n.sf__font-size-20 {\n  font-size: 20px;\n  line-height: 32px;\n}\n.sf__font-size-18 {\n  font-size: 18px;\n  line-height: 30px;\n}\n.sf__font-weight-semibold {\n  font-weight: 600;\n}\n.m-section__subheading,\n.m-richtext__subtitle {\n  font-weight: 600;\n  letter-spacing: 2px;\n  text-transform: uppercase;\n}\n\n.m-product-slider--home .m-featured-slider__product-item {\n  max-width: 300px;\n  margin: 0 auto;\n}\n.m-product-slider--home .m-product-card__name,\n.m-product-slider--home .m-product-card__price {\n  display: none;\n}\n.m-product-slider--home .m-featured-slider__product-content h3 {\n  color: #000000;\n}\n\n.m-testimonial--home .m-testimonial__description {\n  font-weight: 600;\n}\nbody .m-testimonial--home .m-testimonial__fraction {\n  font-weight: 700;\n}\n\n.m-slider--cta .m-custom-content__block {\n  text-align: center;\n}\n.m-slider--cta .section-my {\n  margin-top: 0;\n}\n.m-slider--cta .custom__html {\n  padding: 45px 60px;\n  background: #e6f0f2;\n  border-radius: 15px;\n  text-align: left;\n}\n.m-slider--cta .custom__html .block__text {\n  margin-right: 90px;\n}\n\n.m-blog--home .m-section-my {\n  margin-bottom: 20px;\n}\n\n.m-featured-collection--home .section__header .section__subheading {\n  letter-spacing: 0.1rem;\n  font-weight: 600;\n  font-size: 16px;\n  line-height: 22px;\n}\n.m-featured-collection--home .section__header .section__heading {\n  font-weight: bold;\n  font-size: 48px;\n  line-height: 56px;\n}\n\n.m-section__description {\n  color: var(--color-body-text);\n}\n.m-instagram--home .m-section-my {\n  margin-bottom: 20px;\n}\n\n@media (min-width: 768px) {\n  .m-section__description,\n  .m-section__subheading,\n  .m-richtext__subtitle,\n  .m-slider--cta .custom__html p {\n    font-size: 18px;\n  }\n  .m-product-slider--home .m-featured-slider__container {\n    background: #fff;\n  }\n  .m-blog--home .m-article-card__title {\n    font-size: 24px;\n  }\n}\n\n@media (min-width: 1280px) {\n  .m-testimonial--home .m-testimonial__description {\n    font-size: 34px;\n    line-height: 48px;\n  }\n  .m-testimonial--home .m-testimonial__name {\n    font-size: 20px;\n    font-weight: 600;\n  }\n  body .m-testimonial--home .m-testimonial__fraction {\n    margin-top: 55px;\n    font-size: 18px;\n  }\n  .m-product-slider--home .m-featured-slider__col-left {\n    padding-top: 30px;\n    padding-bottom: 30px;\n  }\n  .m-product-slider--home .m-featured-slider__product  {\n    padding-left: 15px;\n    padding-right: 15px;\n  }\n}\n\n@media(max-width: 767px) {\n  .hide_br_mb br {\n    display: none;\n  }\n  .m-slider--cta .custom__html {\n    padding: 30px 20px;\n    text-align: center;\n  }\n  .m-slider--cta .custom__html .block__text {\n    margin-right: 0;\n    margin-bottom: 30px;\n  }\n  .m-instagram--home .section__description {\n      margin-top: 0;\n  }\n}"
