        "custom_css": ".m-custom--image-card .m-richtext__title {\n  font-size: 26px;\n  line-height: 1.38;\n}\n.m-custom--image-card .m-image-card__content {\n  padding: 25px;\n}\n.m-custom--image-card .m-image-card__content-inner {\n  display: grid;\n  height: 100%;\n}\n.m-custom--image-card .m-richtext__button {\n  align-self: end;\n  justify-self: baseline;\n  margin-top: 12px;\n}\n.m-custom--image-card .m-section-my {\n  margin-top: 30px;\n}\n\n.m-custom--banner .custom__html-block {\n  padding: 56px 48px;\n  background-image: url(\"https:\/\/cdn.shopify.com\/s\/files\/1\/0042\/0750\/9567\/files\/10_caf6ff67-7343-426b-9fdb-b61dd702f87a.jpg?v=1623059274\");\n  background-repeat: no-repeat;\n  background-size: cover;\n  display: flex;\n  border-radius: 10px;\n}\n.m-custom--banner .left__content h3 {\n  font-size: 36px;\n  line-height: 50px;\n  margin-bottom: 15px;\n}\n.m-custom--banner .left__content p {\n  color: var(--color-sub-text);\n}\n.m-custom--banner .right__content span {\n  font-size: 18px;\n  color: #777;\n  text-decoration: line-through;\n  margin-bottom: 15px;\n  display: block;\n}\n.m-custom--banner .right__content h3 {\n  color: #e02b2b;\n  font-size: 30px;\n  margin-bottom: 25px;\n}\n\n.m-slide__subtitle {\n  color: #e02b2b;\n  font-weight: 600;\n}\n\n@media (min-width: 768px) {\n  .m-custom--image-card .image__card-heading {\n    font-size: 1.625rem;\n    line-height: 1.4;\n  }\n  body .m-slider .m-slider-controls--absolute[class*=-bottom-] .swiper-pagination {\n    bottom: 40px;\n  }\n}\n@media (min-width: 1024px) {\n  .m-custom--banner .left__content {\n    margin-right: 150px;\n  }\n}\n\n@media(min-width: 1536px) {\n  .m-collection-list--home{\n    --column-gap: 100px;\n  }\n}\n\n@media (max-width: 767px) {\n  .m-collection-list--home {\n    --mobile-column-width: 37vw;\n  }\n  .m-custom--banner .custom__html-block {\n    display: flex;\n    flex-direction: column;\n    padding: 2rem 0;\n    text-align: center;\n  }\n  .m-icon-box--home .m-icon-box__inner {\n    display: flex;\n    flex-direction: row;\n    align-items: flex-start;\n  }\n  .m-icon-box--home .m-icon-box__content {\n    text-align: left;\n    margin-top: 0 !important;\n    margin-left: 15px;\n  }\n  .m-icon-box--home .m-icon-box__content br {\n    display: none;\n  }\n  .m-icon-box--home .m-icon-box__heading {\n    font-size: 18px;\n  }\n  .m-icon-box--home .m-icon-box__icon {\n    width: 50px !important;\n  }\n}"
      }
