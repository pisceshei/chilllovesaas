    "bbd67a50-4d8a-46ad-94d1-2c3754645182": {
      "type": "custom-code",
      "settings": {
        "custom_css": ".m-header__desktop {\n  padding-top: 20px;\n  padding-bottom: 20px;\n}\n.m-header__desktop .m-header__search {\n  border: 0;\n}\n.m-header__desktop .m-header__search button,\n.m-header__desktop .m-header__search span {\n  padding-left: 0;\n}\nbody .m-product-card .m-product-card__price .m-price { \n  font-weight: 400; \n}\n.m-richtext__subtitle {\n  font-weight: 500;\n}\n.sf-custom--collection-banner .m-image-card--button-fixed .m-button--fixed {\n  border-color: #E7E7E7;\n  padding-top: 16px;\n  padding-bottom: 20px;\n}\n.font-semibold { \n  font-weight: 600; \n}\n.sf-home__iconbox {\n  border-top: 1px solid #eee;\n}\n.sf-home__iconbox .m-icon-box__content h3 {\n  font-size: 18px;\n  line-height: 26px;\n  font-weight: 500;\n  margin-bottom: 2px;\n}\n.m-collection-list--no-wrap .m-collection-card__link {\n  line-height: 1.4;\n  font-weight: 400;\n}\n.m-collection-list--no-wrap .m-collection-card__info {\n  display: flex;\n  justify-content: space-between;\n}\n.m-collection-list--no-wrap .m-collection-card__product-count {\n  align-self: center;\n  flex-shrink: 0;\n  padding-left: 10px;\n}\n@media (min-width: 768px) {\n  .sf-image-with-text--main .m-richtext__title {\n    font-size: 48px;\n  }\n  .sf-image-with-text--main .m-image-with-text__content {\n    padding-left: 30px;\n  }\n  .m-lookbook-slider .m-product-card__content{\n    text-align: center;\n  }\n  .m-collection-list--no-wrap .m-slider-controls {\n    margin-top: 40px;\n  }\n  body .m-lookbook-slider .m-product-option {\n    justify-content: center;\n  }\n}\n\n@media (min-width: 1024px) {\n  .m-collection-list--no-wrap .m-collection-card__info h3 a {\n    font-size: 24px;\n  }\n}\n\n@media (min-width: 1280px) {\n  .sf-image-with-text--main .m-richtext__title {\n    font-size: 64px;\n  }\n  .sf-image-with-text--main .m-image-with-text__content {\n    padding-left: 60px;\n  }\n  .m-richtext__subtitle {\n    font-size: 20px;\n  }\n  .m-collection-list--no-wrap .m-slider-controls {\n    margin-top: 60px;\n  }\n}\n\n@media (min-width: 1536px) {\n  .sf-image-with-text--main .m-richtext__title {\n    font-size: 80px;\n  }\n  .sf-image-with-text--main .m-image-with-text__content {\n    padding-left: 100px;\n  }\n}\n\n@media (max-width: 767px) {\n  .sf-brand-list--home m-brand-list {\n    padding-bottom: 20px;\n  }\n  .sf-custom--collection-banner .image-card--button-fixed .m-button--fixed {\n    justify-content: center;\n    gap: 10px;\n    border: 0;\n  }\n}"
      }
