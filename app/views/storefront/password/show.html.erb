<!doctype html>
<html lang="<%= I18n.locale %>">
<head>
<meta charset="utf-8">
<title><%= current_shop.name %></title>
<meta name="referrer" content="never">
<meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0, maximum-scale=1.0">
<style type="text/css">
  /* PR-10：結構/類名/斷點對表 chill.deals /password 標本（2026-09-01）；
     CSS 原文＝鐵律 9 紅線 ⇒ 量測值重寫、色值走我方 tokens、字型走系統棧 */
  * { margin: 0; padding: 0; border: 0; font-size: 100%; vertical-align: baseline; box-sizing: border-box; }
  html, body { height: 100%; }
  body { font-family: -apple-system, "Segoe UI", Roboto, "Noto Sans TC", sans-serif; color: #202223; background: #f6f6f7; display: flex; flex-direction: column; }
  a { color: inherit; }
  .wrapper { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px; }
  .hero { text-align: center; max-width: 460px; width: 100%; }
  .content--block { margin-bottom: 24px; }
  h2 { font-size: 20px; line-height: 1.3; margin-bottom: 8px; }
  .description { font-size: 14px; color: #6d7175; margin-bottom: 20px; }
  .form-section { text-align: left; }
  .form-wrapper { display: flex; flex-direction: column; gap: 8px; }
  .label-wrapper label { font-size: 13px; color: #202223; }
  .form-input { width: 100%; padding: 10px 12px; border: 1px solid #c9cccf; border-radius: 8px; font-size: 14px; background: #fff; }
  .form-input:focus { outline: 2px solid #005bd1; outline-offset: 1px; }
  .form-input.with-error { border-color: #d72c0d; }
  .error-container { min-height: 18px; }
  .error-message { color: #d72c0d; font-size: 13px; }
  button[type=submit] { margin-top: 12px; padding: 10px 18px; border-radius: 8px; background: #202223; color: #fff; font-size: 14px; cursor: pointer; }
  .notification { margin-top: 32px; font-size: 12.5px; color: #6d7175; text-align: center; }
  @media (min-width: 500px) { h2 { font-size: 24px; } }
</style>
</head>
<body>
<div class="wrapper">
  <div class="hero">
    <div class="content--block">
      <h2><b><%= current_shop.name %></b></h2>
      <p class="description">This store is password protected. Use the password to enter the store.</p>
    </div>
    <div class="content--block form-section">
      <%= form_with url: "/password", method: :post, local: true, html: { "accept-charset" => "UTF-8" } do %>
        <div class="form-wrapper">
          <div class="label-wrapper"><label for="password">Enter store password</label></div>
          <input type="password" class="form-input <%= "with-error" if flash[:password_error] %>" id="password" name="password" autocomplete="nope">
          <div class="error-container"><% if flash[:password_error] %><span class="error-message"><%= flash[:password_error] %></span><% end %></div>
          <button type="submit">Enter</button>
        </div>
      <% end %>
    </div>
    <p class="notification">Are you the store owner? <a href="/admin">Log in here</a></p>
  </div>
</div>
</body>
</html>
